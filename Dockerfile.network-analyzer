FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /uvx /bin/

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates tshark \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin sahabino

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,id=sahabino-network-uv-cache,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-dev --no-install-project

COPY README.md alembic.ini ./
COPY migrations ./migrations
COPY src ./src
RUN --mount=type=cache,id=sahabino-network-uv-cache,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-dev \
    && chown -R sahabino:sahabino /app

USER sahabino

CMD ["uv", "run", "--no-sync", "python", "-m", "sahabino.network", "worker"]
