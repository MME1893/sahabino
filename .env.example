POSTGRES_DB=sahabino
POSTGRES_USER=sahabino
POSTGRES_PASSWORD=sahabino

# Application logging
SAHABINO_LOG_LEVEL=INFO
SAHABINO_LOG_FORMAT=console
SAHABINO_ENVIRONMENT=development

# Local-development Grafana credentials only; do not use these in production.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=sahabino

SAHABINO_DATABASE_URL=postgresql+psycopg://sahabino:sahabino@localhost:5432/sahabino
SAHABINO_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SAHABINO_KAFKA_TOPIC_PARTITIONS=3
SAHABINO_KAFKA_TOPIC_REPLICATION_FACTOR=1
SAHABINO_KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
SAHABINO_KAFKA_PRODUCER_QUEUE_FULL_MAX_RETRIES=3
SAHABINO_KAFKA_PRODUCER_QUEUE_FULL_POLL_TIMEOUT_SECONDS=0.1

# Google Play crawler (the proxy list is a JSON array; never commit credentials)
SAHABINO_PLAYSTORE_CRAWL_INTERVAL_MINUTES=60
SAHABINO_PLAYSTORE_MAX_CONCURRENT_APPS=3
SAHABINO_PLAYSTORE_LANGUAGE_CODE=en
SAHABINO_PLAYSTORE_COUNTRY_CODE=us
SAHABINO_PLAYSTORE_REQUEST_TIMEOUT_SECONDS=20
SAHABINO_PLAYSTORE_RETRY_MAX_ATTEMPTS=3
SAHABINO_PLAYSTORE_RETRY_MAX_DELAY_SECONDS=30
SAHABINO_PLAYSTORE_RATE_LIMIT_ENABLED=true
SAHABINO_PLAYSTORE_RATE_LIMIT_REFILL_PER_SECOND=1.0
SAHABINO_PLAYSTORE_RATE_LIMIT_BURST_CAPACITY=2
SAHABINO_PLAYSTORE_PROXY_ENABLED=false
SAHABINO_PLAYSTORE_PROXY_URLS=[]
SAHABINO_PLAYSTORE_PROXY_DIRECT_FALLBACK=true
SAHABINO_PLAYSTORE_PROXY_FAILURE_THRESHOLD=2
SAHABINO_PLAYSTORE_PROXY_COOLDOWN_SECONDS=60
SAHABINO_PLAYSTORE_PROXY_RATE_LIMIT_ROTATE_AFTER=2
SAHABINO_PLAYSTORE_CIRCUIT_BREAKER_ENABLED=true
SAHABINO_PLAYSTORE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
SAHABINO_PLAYSTORE_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
SAHABINO_PLAYSTORE_SECONDARY_ADAPTER_ENABLED=true
SAHABINO_APPLICATION_REGISTRY_BASE_URL=http://localhost:8000
