    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sahabino-postgres"
      },
      "description": "Tasks created in the selected range grouped by application and current status.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
