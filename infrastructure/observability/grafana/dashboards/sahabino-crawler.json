          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sahabino-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.name AS \"Application\", t.status AS \"Status\", count(t.id) AS \"Tasks\" FROM crawl_tasks t JOIN applications a ON a.id = t.application_id WHERE $__timeFilter(t.created_at) GROUP BY a.name, t.status ORDER BY a.name, t.status;",
          "refId": "A"
        }
      ],
      "title": "Application task breakdown",
      "type": "table"
    }
