    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sahabino-postgres"
      },
      "description": "Average elapsed seconds for completed tasks by completion time and task type. Missing timestamps remain absent.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sahabino-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(finished_at, '1h'), task_type AS metric, avg(EXTRACT(EPOCH FROM (finished_at - started_at))) AS value FROM crawl_tasks WHERE $__timeFilter(finished_at) AND started_at IS NOT NULL AND finished_at IS NOT NULL GROUP BY 1, 2 ORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "Average completed task duration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sahabino-postgres"
      },
      "description": "Persisted attempt_count summary. Attempts are not automatically labeled retries.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sahabino-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT task_type AS \"Task type\", count(id) AS \"Tasks\", round(avg(attempt_count)::numeric, 2) AS \"Average attempts\", max(attempt_count) AS \"Maximum attempts\" FROM crawl_tasks WHERE $__timeFilter(created_at) GROUP BY task_type ORDER BY task_type;",
          "refId": "A"
        }
      ],
      "title": "Recorded attempts by task type",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sahabino-postgres"
      },
      "description": "Failed tasks in the selected range grouped by bounded error code; error messages are never selected.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sahabino-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(error_code, 'unspecified') AS \"Error code\", count(id) AS \"Failures\" FROM crawl_tasks WHERE status = 'failed' AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 20;",
          "refId": "A"
        }
      ],
      "title": "Failure error codes",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sahabino-postgres"
      },
      "description": "Recent failed tasks without raw error messages, joined to application metadata.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 8,
        "y": 17
      },
      "id": 8,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sahabino-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.finished_at AS \"Finished\", a.name AS \"Application\", t.task_type AS \"Task type\", t.error_code AS \"Error code\", t.attempt_count AS \"Recorded attempts\", t.language_code AS \"Language\", t.country_code AS \"Country\" FROM crawl_tasks t JOIN applications a ON a.id = t.application_id WHERE t.status = 'failed' ORDER BY t.finished_at DESC NULLS LAST LIMIT 100;",
          "refId": "A"
        }
      ],
      "title": "Latest failed tasks",
      "type": "table"
    },
