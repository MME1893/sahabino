          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS \"Created\", trigger_type AS \"Trigger\", status AS \"Status\", started_at AS \"Started\", finished_at AS \"Finished\", CASE WHEN started_at IS NOT NULL AND finished_at IS NOT NULL THEN EXTRACT(EPOCH FROM (finished_at - started_at)) END AS \"Duration seconds\" FROM crawl_runs ORDER BY created_at DESC LIMIT 50;",
