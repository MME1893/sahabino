      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sahabino-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT score::text || ' stars' AS metric, count(id) AS value FROM reviews GROUP BY score ORDER BY score;",
          "refId": "A"
        }
      ],
      "title": "Current unique-review rating distribution",
