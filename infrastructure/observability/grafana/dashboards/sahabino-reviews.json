    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sahabino-postgres"
      },
      "description": "All-time unique review identity count per registered application; not the store-reported review total.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "id": 8,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sahabino-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.name AS \"Application\", count(r.id) AS \"Unique reviews\" FROM applications a LEFT JOIN reviews r ON r.application_id = a.id GROUP BY a.id, a.name ORDER BY 2 DESC, a.name;",
          "refId": "A"
        }
      ],
      "title": "Unique reviews by application",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sahabino-postgres"
      },
      "description": "Recent observation metadata only; review content, external IDs and authors are excluded.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sahabino-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT o.observed_at AS \"Observed\", a.name AS \"Application\", o.score AS \"Score\", o.position AS \"Position\", o.source_adapter AS \"Adapter\", o.sentiment_status AS \"Sentiment status\", o.sentiment_label AS \"Sentiment label\" FROM review_observations o JOIN reviews r ON r.id = o.review_id JOIN applications a ON a.id = r.application_id ORDER BY o.observed_at DESC LIMIT 100;",
          "refId": "A"
        }
      ],
      "title": "Latest observations",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sahabino-postgres"
      },
      "description": "Cumulative unique reviews first observed during the selected range; no pre-range baseline is implied.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "id": 10,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sahabino-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH daily AS (SELECT date_trunc('day', first_observed_at) AS day, count(id) AS count FROM reviews WHERE $__timeFilter(first_observed_at) GROUP BY 1) SELECT day AS \"time\", sum(count) OVER (ORDER BY day) AS \"Cumulative unique reviews\" FROM daily ORDER BY day;",
          "refId": "A"
        }
      ],
      "title": "Review growth in selected range",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sahabino-postgres"
      },
      "description": "Bounded aggregate indicators; NULL source timestamps remain visible rather than becoming fake zeros.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "id": 11,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sahabino-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Observations with missing source timestamp' AS \"Indicator\", count(review_id) AS \"Count\" FROM review_observations WHERE source_at IS NULL UNION ALL SELECT 'Sentiment processing failures', count(review_id) FROM review_observations WHERE sentiment_status = 'failed' UNION ALL SELECT 'Unique reviews never re-observed', count(id) FROM reviews WHERE first_observed_at = last_observed_at;",
          "refId": "A"
        }
      ],
      "title": "Available data-quality indicators",
      "type": "table"
    }
  ],
