# Copy to .env, keep mode 0600, and replace every CHANGE_ME value.
# Never commit .env or files below secrets/.

METABASE_PORT=3001
BI_DB_NETWORK=sahabino-bi-db

# Stable alias on BI_DB_NETWORK, not a published PostgreSQL host port.
MB_DB_HOST=sahabino-postgres-bi
MB_DB_PORT=5432

# Metabase's private application/metadata database. This is not sahabino.
MB_DB_DBNAME=metabase_app
MB_DB_USER=metabase_app
METABASE_APP_DB_PASSWORD_FILE=/opt/sahabino-bi/secrets/metabase_app_db_password

# Generate independent high-entropy values and store them only in this ignored file.
# Metabase v0.63.18 does not support _FILE for these two settings.
MB_ENCRYPTION_SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
MB_SESSION_SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES

# Optional, operator-managed backup directory; preflight reports if absent.
BI_METADATA_BACKUP_DIR=/opt/sahabino-bi/backups
